APP_ENV=development
APP_NAME=QueueCare API
API_V1_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Fill these in only in your local ignored .env file or the backend host's secret settings.
# Do not commit real Supabase keys or database credentials.
SUPABASE_URL=
SUPABASE_JWKS_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Set this to the clinic's IANA timezone after clinic details are confirmed.
TIME_ZONE=Asia/Kolkata
